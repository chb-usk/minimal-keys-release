#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#undef ZMK_POINTING_DEFAULT_SCRL_VAL

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        BT0Mac: BT0Mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 0>;
            label = "BT0MAC";
        };

        BT1Mac: BT1Mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 0>;
            label = "BT1MAC";
        };

        BT2Win: BT2Win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &to 1>;
            label = "BT2WIN";
        };

        BT3Win: BT3Win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &to 1>;
            label = "BT3WIN";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        scroll: scroll {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        };

        zip_temp_layer: zip_temp_layer {
            compatible = "zmk,input-processor-temp-layer";
            #binding-cells = <2>;
            #input-processor-cells = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer_mac {
            bindings = <
&kp Q             &kp W             &kp E         &kp R               &kp T                                      &kp Y                &kp U  &kp I      &kp O    &kp P
&kp A             &kp S             &kp D         &kp F               &kp G        &mkp MB1         &mkp MB2     &kp H                &kp J  &kp K      &kp L    &kp MINUS
&mt LEFT_SHIFT Z  &kp X             &kp C         &kp V               &kp B        &kp BACKSPACE    &kp DELETE   &kp N                &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp TAB           &kp LEFT_CONTROL  &kp LEFT_ALT  &mt LEFT_GUI LANG2  &lt 2 SPACE  &lt 3 ENTER      &lt 4 ENTER  &mt RIGHT_GUI LANG1                             &kp RIGHT_CONTROL
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        default_layer_win {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                   &kp T                                      &kp Y                    &kp U  &kp I      &kp O    &kp P
&kp A             &kp S         &kp D         &kp F                   &kp G        &mkp MB1         &mkp MB2     &kp H                    &kp J  &kp K      &kp L    &kp MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                   &kp B        &kp BACKSPACE    &kp DELETE   &kp N                    &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp TAB           &kp LEFT_WIN  &kp LEFT_ALT  &mt LEFT_CONTROL LANG2  &lt 2 SPACE  &lt 3 ENTER      &lt 4 ENTER  &mt RIGHT_CONTROL LANG1                             &kp RIGHT_ALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        SYMBOL {
            bindings = <
&kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)                    &kp LS(NUMBER_6)  &kp LS(NUMBER_7)  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp LS(NUMBER_0)
&kp ESCAPE        &trans            &trans            &trans            &trans            &trans    &trans  &kp MINUS         &kp EQUAL         &kp LEFT_BRACE    &kp RIGHT_BRACE   &kp BACKSLASH
&trans            &trans            &trans            &trans            &trans            &trans    &trans  &kp LS(MINUS)     &kp LS(EQUAL)     &kp APOS          &kp SEMI          &kp LS(BACKSLASH)
&trans            &trans            &trans            &trans            &trans            &trans    &trans  &trans                                                                  &trans
            >;
        };

        MUMBER {
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans    &trans
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &trans    &trans      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS  &kp MINUS
&kp F11  &kp F12  &kp F13  &kp F14  &kp F15  &trans    &trans      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp STAR  &kp SLASH
&trans   &trans   &trans   &trans   &trans   &trans    &kp PERIOD  &kp NUMBER_0                                        &trans
            >;
        };

        MOVE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &kp LG(LEFT)   &trans    &kp UP    &trans     &kp PAGE_UP
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp LG(RIGHT)  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PAGE_DOWN
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans         &trans    &trans    &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &mo 5                                         &trans
            >;
        };

        BLUETOOTH {
            bindings = <
&trans      &BT0Mac  &BT1Mac  &BT2Win  &BT3Win                    &trans  &trans  &trans  &trans  &trans
&trans      &trans   &trans   &trans   &trans   &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans   &trans   &trans   &trans   &trans    &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR  &trans   &trans   &trans   &trans   &trans    &trans  &trans                          &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &kp PAGE_UP   &trans    &kp PAGE_DOWN  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &mkp MB1      &mkp MB3  &mkp MB2       &mo 7
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &kp LG(LEFT)  &trans    &kp LG(RIGHT)  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                         &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;
        };
    };
};
